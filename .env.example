# ============================================================
# StorSight - Environment Configuration Template
# ============================================================
# IMPORTANT:
# This file contains placeholders only.
# Never put real secrets, passwords, API keys, or production
# credentials in this file.
#
# Copy this file to .env for local development:
#
#   cp .env.example .env
#
# Windows Git Bash:
#   cp .env.example .env
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME=StorSight
APP_ENV=development
APP_DEBUG=true


# ------------------------------------------------------------
# Flask
# ------------------------------------------------------------

FLASK_APP=app
FLASK_ENV=development

# Replace this placeholder only in your local .env file.
SECRET_KEY=change-this-development-secret-key


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# Local development database.
# This will be configured when the database layer is implemented.
DATABASE_URL=sqlite:///storsight.db


# ------------------------------------------------------------
# Testing
# ------------------------------------------------------------

TESTING=false

# Test database configuration will be introduced during
# the testing/database implementation phase.
TEST_DATABASE_URL=sqlite:///storsight_test.db


# ------------------------------------------------------------
# Application Logging
# ------------------------------------------------------------

LOG_LEVEL=INFO


# ------------------------------------------------------------
# Session / Security
# ------------------------------------------------------------

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax


# ------------------------------------------------------------
# Frontend / CORS
# ------------------------------------------------------------

# Origin of the Angular frontend for CORS.
# Development default: Angular CLI dev server.
# Production: set to the actual deployed frontend URL.
FRONTEND_ORIGIN=http://localhost:4200


# ------------------------------------------------------------
# Production deployment
# ------------------------------------------------------------

# Production must use APP_ENV=production and a random secret of 32+ chars.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/storsight
# APP_ENV=production
# SECRET_KEY=replace-with-a-random-32-character-secret
# SESSION_COOKIE_SECURE=true
# RATE_LIMIT_STORAGE_URI=redis://host:6379/0
# Email delivery over HTTPS (recommended for free web hosting).
# MAIL_PROVIDER=api
# MAIL_API_URL=https://api.resend.com/emails
# MAIL_API_KEY=re_secret-key
# MAIL_FROM=no-reply@your-verified-domain.com
# SMTP is also supported when the host permits outbound SMTP:
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=replace-me
# MAIL_PASSWORD=replace-me
# MAIL_USE_TLS=true
# MONITORING_ENABLED=true
# MONITORING_INTERVAL_SECONDS=60
# STORAGE_CONNECT_TIMEOUT_SECONDS=10
# STORAGE_MAX_RETRIES=2
# In production with separate frontend and API domains, set
# SESSION_COOKIE_SAMESITE=None and SESSION_COOKIE_SECURE=true.
# ADMIN_USERNAME=first-admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password

# Configure these DNS records at your email provider/domain registrar:
# SPF: authorize the provider that sends mail for your domain.
# DKIM: publish the provider-generated signing public key.
# DMARC: start with a monitoring policy such as p=none, then enforce it.
